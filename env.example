# ==============================================================================
# env.example - Template for QSE Pod configuration
#
# Copy this file to .env and fill in your values before running locally.
# In Kubernetes/OpenShift these values are injected via ConfigMap and Secret.
# NEVER commit .env with real values to source control.
#
# Changes:
#   2026-08-21 04:01:56 - Initial creation
#   2026-08-21 04:10:14 - Multi-repo: replaced GIT_REPO_URL with REPOS_FILE; updated path vars
# ==============================================================================

# ---- Git credentials (apply to all repos in the repos list) -----------------
GIT_USERNAME=your-git-username           # Leave empty for public repos
GIT_TOKEN=your-git-personal-access-token # HashiCorpIgnore

# ---- Repository list (local development only) --------------------------------
# In-cluster the repos file is mounted from the qse-pod-repos ConfigMap.
# For local testing, point to a local YAML file in the same format.
REPOS_FILE=./repos-local.yaml

# ---- Guardium Cryptography Manager -------------------------------------------
GCM_SERVER_URL=https://gcm.your-domain.com
GCM_API_KEY=your-gcm-api-key             # HashiCorpIgnore

# ---- Default scan metadata ---------------------------------------------------
APP_VERSION=                             # Leave empty to auto-detect from commit SHA

# ---- Default scan behaviour --------------------------------------------------
# Comma-separated paths to exclude — can be overridden per-repo in repos.yaml
EXCLUDE_PATHS=src/test,vendor,node_modules,.git

# Set to "true" to scan all QSE-supported languages regardless of detection
SCAN_ALL_LANGUAGES=false

# ---- Persistence paths (override defaults if needed) -------------------------
# Each repo gets its own sub-directory under these base paths
QSE_OUTPUT_BASE_DIR=/opt/qse-pod/results/scans
LAST_COMMIT_BASE_DIR=/opt/qse-pod/results/commits

# ---- In-cluster ConfigMap patch (optional) ----------------------------------
# If set, the scan script patches this ConfigMap with per-repo last commit SHAs
CONFIGMAP_NAME=qse-pod-config
CONFIGMAP_NAMESPACE=qse-pod

# ---- Confirmation prompt behaviour ------------------------------------------
# Set to "true" to suppress the interactive confirmation prompt.
# Automatically skipped in non-interactive (CronJob) runs.
ALWAYS_ALLOW=false
