# ==============================================================================
# qse-github.env.example - Input for setup-github-config.sh
#
# Copy to .qse-github.env (git-ignored), fill in, then run:
#   ./setup-github-config.sh --repo OWNER/REPO
#
# Format: KEY=VALUE, one per line. A trailing ' # comment' (space before '#')
# on an unquoted value is ignored; quote the value to keep a ' #' in it.
# Empty values are skipped.
# NEVER commit the filled-in file.
#
# Changes:
#   2026-11-17 01:27:10 - Initial creation
# ==============================================================================

# ---- SECRETS (stored as GitHub Actions secrets) ------------------------------
# REQUIRED: PAT with read access to the private repo that holds cli.sh
QSE_TOKEN=your-qse-cli-repo-read-token                 # HashiCorpIgnore
# Only needed when GCM_UPLOAD_ENABLED=true
GCM_BEARER_TOKEN=

# ---- VARIABLES (stored as GitHub Actions variables) --------------------------
# GCM upload is OFF unless set to true (then GCM_SERVER_URL + GCM_BEARER_TOKEN are required)
GCM_UPLOAD_ENABLED=false
GCM_SERVER_URL=

# QSE CLI repository (defaults shown; leave empty to use the workflow defaults)
QSE_REPO_URL=https://github.com/ncee-dp-tech-sme/qsecli.git
QSE_REPO_URL=https://github.com/ncee-dp-tech-sme/qsecli.git
QSE_CLI_SUBDIR=CLI
QSE_CLI_REF=
QSE_GIT_USERNAME=

# Scan settings (all optional)
QSE_APP_NAME=
APP_VERSION=
EXCLUDE_PATHS=src/test,vendor,node_modules
QSE_LANGUAGES=
PY_MODULE_PATH=
QSE_JAVA_VERSION=17
